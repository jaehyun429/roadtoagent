# 복사해서 .env 로 저장하고 값 채우기. .env는 gitignore에 걸려 있음.
CAMPUS_URL=https://dcs-learning.cnu.ac.kr
# 브라우저 개발자도구 > Network > 아무 /api/v1 요청 > Headers > Request Headers > Cookie 줄 전체
CAMPUS_COOKIE=
# 사이트 JS /js/assets/gibberish-aes-*.js 의 getSecKey()가 돌려주는 32글자
CAMPUS_AES_KEY=
# 비우면 오늘 날짜로 현재 학기 계산. 2학기 수업이 없으면 1학기로 고정:
CAMPUS_TERM_YEAR=2026
CAMPUS_TERM_CD=10

# 자동 로그인 (쿠키가 없거나 만료되면 서버가 직접 로그인). 일반 로그인: 학번 + 포털 비밀번호
CNU_ID=
CNU_PASSWORD=
